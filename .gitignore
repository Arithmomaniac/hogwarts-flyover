__pycache__/

# Local Python environment: created per worktree from requirements.lock.txt (see REBUILD.md); no uv.lock is kept
/.venv/
/uv.lock

# Data pipeline inputs and intermediates are not tracked (see README); build/data.js and build/meshes.js are the only ones the page needs.
/build/*
!/build/data.js
!/build/meshes.js
/raw/
/txt/
/img/
/legend/
/dem/
/s2tiles/
/*.npy
/*.npz
/osm*.json

# Screenshots and debug previews
/view/
